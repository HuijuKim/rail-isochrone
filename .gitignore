# 구글 지도 API 키. 절대 올리지 않는다.
config.json

# 내려받거나 빌드해서 만드는 데이터 (680 MB).
# README 의 순서대로 돌리면 그대로 재현된다.
data/osm/
# 추출본을 훑은 결과. 추출본만 있으면 다시 만들어진다.
data/cache/
data/regions/*/raw/
data/regions/*/walk/
data/regions/*/stops.json
data/regions/*/graph-*.npz
data/regions/*/prefectures.json

# 권역 설정 자체는 코드에 가깝다. 이것만 남긴다.
!data/regions/*/region.json

# 현 조합 탭(make_region.py)으로 만든 권역은 쓰는 사람마다 다르다. 통째로 뺀다.
data/regions/custom_*/

# 주문 목록과 구현 현황. 작업용 메모라 저장소에는 올리지 않는다.
REQUESTS.md

__pycache__/
*.pyc
.pytest_cache/

# 빌드·서버 로그. 돌릴 때마다 새로 쌓인다.
*.log

# 빌드를 지켜보는 도우미. 손에 맞게 고쳐 쓰는 것이라 안 올린다.
watch-build.ps1

# 위키백과에서 받아 둔 원문 캐시(29 MB). build_colors.py 가 다시 받는다.
# 거기서 뽑아낸 data/line-colors.json 만 올린다.
data/line-colors-wiki.json

# 무엇이 빠졌나 재어 본 것. 그때그때 다시 뽑으면 된다.
station_tags_*.json
missing_*.json
data/line-audit.txt
dist/
data/honsu/
